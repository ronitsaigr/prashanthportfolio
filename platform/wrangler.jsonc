{
  "name": "prashanthportfolio",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prashanth-platform-preview",
      "database_id": "1fc00207-9a8f-46d3-9feb-c1d7b3bfd921",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGNAD7StUyi6KUw-",
    "ENABLE_PUBLIC_FORMS": "false"
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "30 2 * * MON"
    ]
  }
}
