---
import '../styles/global.css';
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Prashanth Rapelli | Business systems</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <main class="mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-6 py-20">
      <p class="mb-5 text-sm font-semibold uppercase tracking-widest text-teal-700 dark:text-teal-400">Prashanth Rapelli · Platform preview</p>
      <h1 class="max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-6xl">Business problems. Systems that actually get used.</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">AI and automation, revenue operations, and practical training for businesses and institutions.</p>
      <div class="mt-10 border-t border-slate-200 pt-5 text-sm text-slate-600 dark:border-slate-800 dark:text-slate-300">Development preview — no enquiries or payments are collected here yet.</div>
    </main>
  </body>
</html>
